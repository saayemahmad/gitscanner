# Cloudflare Turnstile Configuration
# To get your production keys:
# 1. Log in to https://dash.cloudflare.com/
# 2. Go to "Turnstile" and click "Add Site"
# 3. Enter your domain (e.g., localhost or yourwebsite.com)
# 4. Copy your Site Key and Secret Key and paste them below:
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=true

# Google OAuth 2.0 Configuration
# Get Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_LOGIN_ENABLED=true

# Database Configuration (MySQL / MariaDB)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=renewal_blood

# Admin Dashboard Password
ADMIN_PASSWORD=your_admin_password
